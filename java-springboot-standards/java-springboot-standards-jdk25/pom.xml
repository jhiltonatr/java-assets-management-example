<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.company</groupId>
        <artifactId>java-springboot-standards</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>java-springboot-standards-jdk25</artifactId>
    <packaging>pom</packaging>

    <name>Java Spring Boot Standards (JDK 25)</name>
    <description>Spring Boot standards BOM on top of java-company-standards-jdk25.</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <checkstyle.location>company/checkstyle-jdk25.xml</checkstyle.location>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Pin Jackson 3 (tools.jackson) at a CVE-fixed version. Declared here
                 (closer to consumers than the spring-boot-dependencies import), so
                 it wins for every tools.jackson artifact. -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <dependencies>
                        <dependency>
                            <groupId>com.example.company</groupId>
                            <artifactId>java-company-standards-jdk25</artifactId>
                            <version>1.0.0-SNAPSHOT</version>
                        </dependency>
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>10.21.0</version>
                        </dependency>
                    </dependencies>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>