<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.company</groupId>
        <artifactId>java-springboot-standards</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>java-springboot-standards-jdk25</artifactId>
    <packaging>pom</packaging>

    <name>Java Spring Boot Standards (JDK 25)</name>
    <description>Spring Boot standards BOM on top of java-company-standards-jdk25.</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <checkstyle.location>company/checkstyle-jdk25.xml</checkstyle.location>

        <spring-boot.version>4.1.1</spring-boot.version>
        <springdoc.version>2.3.0</springdoc.version>

        <!-- Spring Boot 4.1.x ships Logback 1.5.38 and Jackson 3.1.5 in its BOM.
             Logback is raised to the CVE-fixed line 1.6.3 (CVE-2026-19880) via the
             inherited java-company-standards dependencyManagement, which pins classic
             and core to the same ${logback.version}. Jackson 3 is pinned to 3.1.6
             (CVE-2026-83557) by importing tools.jackson:jackson-bom below; the
             property alone is NOT enough because the Spring Boot BOM interpolates
             its own property at import time. JUnit 6.x is used by Spring Boot 4.x,
             so the inherited junit.version 6.1.3 is kept. -->
        <jackson-bom.version>3.1.6</jackson-bom.version>
        <logback.version>1.6.3</logback.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Pin Jackson 3 (tools.jackson) at a CVE-fixed version. Declared here
                 (closer to consumers than the spring-boot-dependencies import), so
                 it wins for every tools.jackson artifact. -->
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <dependencies>
                        <dependency>
                            <groupId>com.example.company</groupId>
                            <artifactId>java-company-standards-jdk25</artifactId>
                            <version>1.0.0-SNAPSHOT</version>
                        </dependency>
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>10.21.0</version>
                        </dependency>
                    </dependencies>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>