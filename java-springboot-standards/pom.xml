<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.company</groupId>
        <artifactId>java-company-standards</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../java-company-standards/pom.xml</relativePath>
    </parent>

    <artifactId>java-springboot-standards</artifactId>
    <packaging>pom</packaging>

    <name>Java Spring Boot Standards</name>
    <description>
        Shared scope that layers the Spring Boot settings on top of the plain-Java company
        standards: imports the Spring Boot dependencies BOM and manages the
        spring-boot-maven-plugin. It is extended by the concrete artifacts
        java-springboot-standards-jdk17 and java-springboot-standards-jdk21, which pin the JDK
        level. Consumers should use the concrete -jdkXX BOMs.
    </description>

    <properties>
        <spring-boot.version>4.1.1</spring-boot.version>
        <springdoc.version>3.1.1</springdoc.version>
        <jackson-bom.version>3.2.3</jackson-bom.version>
        <logback.version>1.6.3</logback.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot platform BOM. Entries managed here and in the inherited
                 java-company-standards parent take precedence over this import, so the
                 company standards keep winning on shared library versions. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Going beyond the Spring Boot platform BOM -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <id>repackage</id>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.codehaus.gmavenplus</groupId>
                <artifactId>gmavenplus-plugin</artifactId>
                <version>5.0.0</version>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.groovy</groupId>
                        <artifactId>groovy</artifactId>
                        <version>5.0.6</version>
                        <scope>runtime</scope>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.groovy</groupId>
                        <artifactId>groovy-ant</artifactId>
                        <version>5.0.6</version>
                        <scope>runtime</scope>
                    </dependency>
                    <dependency>
                        <groupId>org.apache.groovy</groupId>
                        <artifactId>groovy-json</artifactId>
                        <version>5.0.6</version>
                        <scope>runtime</scope>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>generate-bom-reference-docs</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>execute</goal>
                        </goals>
                        <configuration>
                            <scripts>
                                <script><![CDATA[
                                    // Locate the shared generator by walking up from this module's basedir.
                                    // Works for the template itself, the -jdkXX flavors and standalone
                                    // consumers like sample-springboot-app (whose multiModuleProjectDirectory
                                    // is not the reactor root).
                                    def scriptFile = null
                                    def dir = project.basedir
                                    while (dir != null) {
                                        def candidate = new File(dir, "java-springboot-standards/src/main/resources/bom-docs.groovy")
                                        if (candidate.exists()) { scriptFile = candidate; break }
                                        dir = dir.parentFile
                                    }
                                    if (scriptFile != null) {
                                        log.info("Executing external script: " + scriptFile.absolutePath)
                                        evaluate(scriptFile)
                                    } else {
                                        log.warn("Could not locate bom-docs.groovy for " + project.artifactId)
                                    }
                                    ]]></script>
                            </scripts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>