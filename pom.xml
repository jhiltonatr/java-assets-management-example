<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.company</groupId>
    <artifactId>maven-standards</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Maven Standards Aggregator</name>
    <description>
        Aggregator for the company-wide Maven standards BOMs. Each JDK level gets its own Maven
        project, so every variant ships with a stable, concrete artifactId:
        - java-company-standards:                   shared plain-Java settings template (defaults to JDK 17)
        - java-company-standards-jdk17 / -jdk21:    plain-Java BOMs, one per JDK level
        - java-springboot-standards:                shared Spring Boot settings template
        - java-springboot-standards-jdk17 / -jdk21: Spring Boot BOMs on top of the matching
                                                    java-company-standards variant
        A single `mvn install` publishes every variant to the local repository.
    </description>

    <modules>
        <module>java-company-standards</module>
        <module>java-company-standards/java-company-standards-jdk17</module>
        <module>java-company-standards/java-company-standards-jdk21</module>
        <module>java-company-standards/java-company-standards-jdk25</module>
        <module>java-springboot-standards</module>
        <module>java-springboot-standards/java-springboot-standards-jdk17</module>
        <module>java-springboot-standards/java-springboot-standards-jdk21</module>
        <module>java-springboot-standards/java-springboot-standards-jdk25</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- OWASP dependency-check (CVE scanning). Pinned to 12.2.2 - 13.0.x currently fails to
             update the NVD feed without an API key (empty nvd.api.key is treated as a supplied
             key and aborts with "Invalid API Key, length of 0"; see dependency-check #8715). -->
        <dependency-check.version>12.2.2</dependency-check.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>${dependency-check.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>